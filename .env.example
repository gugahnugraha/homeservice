# ============================================================
# HOME SERVICES MARKETPLACE ENVIRONMENT CONFIGURATION
# ============================================================

# App Configuration & Configurable Branding Identity
NEXT_PUBLIC_APP_NAME="HomeFix Marketplace"
NEXT_PUBLIC_APP_TAGLINE="Trusted Local Professionals for Home Repairs, Cleaning & Maintenance"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CITY="Jakarta"
NEXT_PUBLIC_DEFAULT_COMMISSION_RATE=0.15
NEXT_PUBLIC_DEFAULT_LANGUAGE="id"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeservice_db?schema=public"

# Auth Secret
JWT_SECRET="super-secret-homeservice-jwt-key-change-in-production-2026"
SESSION_COOKIE_NAME="homeservice_session"

# ============================================================
# CLOUDFLARE R2 OBJECT STORAGE CONFIGURATION
# ============================================================
STORAGE_PROVIDER="r2"
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
CLOUDFLARE_R2_BUCKET_NAME="homeservice-storage"
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev"

# ============================================================
# MIDTRANS SANDBOX PAYMENT GATEWAY CONFIGURATION
# ============================================================
PAYMENT_PROVIDER="midtrans"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SANDBOX_SERVER_KEY_HERE"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY_HERE"
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
MIDTRANS_API_URL="https://api.sandbox.midtrans.com"
